# API Keys — only set the key for the provider you're using
# LiteLLM supports 100+ providers: https://docs.litellm.ai/docs/providers
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Format: provider/model_id
MODEL_NAME=gemini/gemini-2.5-flash
ROUTER_MODEL_NAME=gemini/gemini-2.5-flash-lite
LLM_TIMEOUT_SECONDS=45

# PostgreSQL short-term chat memory
DATABASE_URL=postgresql://localhost:5432/company_chatbot
MAX_HISTORY_TOKENS=2000

# Retrieval tuning
RETRIEVAL_TOP_K=6
BM25_CANDIDATE_POOL=10
# Retrieval strategy: vector | bm25 | hybrid
RETRIEVAL_STRATEGY=hybrid
# History-aware query rewriting before retrieval (resolves follow-ups)
QUERY_REWRITE_ENABLED=true

# ==============================
# Paths
# ==============================
CHROMA_DB_PATH=./data/chroma_db
DOCS_PATH=./data/docs
SYSTEM_PROMPT_PATH=../docs/system_prompt.txt

# ==============================
# Frontend (read from the environment by the Streamlit app)
# ==============================
# Optional. If the policy PDF is hosted in Google Drive, set this to its public
# share link and the sidebar download becomes a link to it. Leave unset to serve
# the indexed PDF directly from the backend.
# DOC_DRIVE_URL=

# ==============================
# Auth / JWT (required — server refuses to boot without JWT_SECRET)
# ==============================
# Generate a long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Optional overrides
JWT_EXPIRY_HOURS=8
JWT_ALGORITHM=HS256
# Access/refresh token lifetimes
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
# Refresh-cookie Secure flag. Keep true in prod (https). Set false for LOCAL dev:
# over http://localhost a Secure cookie is never sent, so /auth/refresh would get
# no cookie and refresh would fail.
COOKIE_SECURE=true
# Allowed browser origin — used for CORS and the /auth/refresh CSRF origin check.
# Point at the React dev server.
FRONTEND_ORIGIN=http://localhost:5173

# Rate limits (slowapi syntax: "<count>/<period>")
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_LOGIN=10/minute
# LLM resilience: retry transient errors, and cap retrieved-context tokens
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.5
LLM_CONTEXT_TOKEN_BUDGET=6000

# Seed passwords for `python -m backend.seed_users` (never commit real values)
SEED_HR_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
SEED_EMPLOYEE2_PASSWORD=
