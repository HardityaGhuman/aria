{
  "components": {
    "schemas": {
      "Body_upload_document_admin_documents_upload_post": {
        "properties": {
          "department": {
            "title": "Department",
            "type": "string"
          },
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file",
          "department"
        ],
        "title": "Body_upload_document_admin_documents_upload_post",
        "type": "object"
      },
      "ChatRequest": {
        "description": "Body for ``POST /chat``.",
        "properties": {
          "message": {
            "description": "The user's question.",
            "title": "Message",
            "type": "string"
          },
          "session_id": {
            "default": "demo",
            "description": "Conversation id; each session keeps its own history.",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "description": "Standardized envelope for ``POST /chat``.\n\n``status`` lets the client distinguish a grounded answer from a graceful\nnon-answer without string-matching the prose: ``ok`` (answered),\n``no_results`` (nothing found), ``blocked`` (RBAC-restricted), ``refused``\n(out of scope).",
        "properties": {
          "answer": {
            "description": "The assistant's answer text.",
            "title": "Answer",
            "type": "string"
          },
          "latency_ms": {
            "description": "Server-side time to produce the answer.",
            "title": "Latency Ms",
            "type": "integer"
          },
          "session_id": {
            "description": "The conversation id this reply belongs to.",
            "title": "Session Id",
            "type": "string"
          },
          "sources": {
            "description": "Cited documents behind the answer (empty when not grounded).",
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "title": "Sources",
            "type": "array"
          },
          "status": {
            "description": "ok | no_results | blocked | refused.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "answer",
          "latency_ms",
          "session_id",
          "status"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
      "CreateSessionResponse": {
        "description": "Response for ``POST /chat/sessions``.",
        "properties": {
          "session_id": {
            "description": "The newly created conversation id.",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "CreateSessionResponse",
        "type": "object"
      },
      "DeleteResponse": {
        "description": "Response for ``DELETE /admin/documents/{document_id}``.",
        "properties": {
          "deleted_chunks": {
            "description": "Number of vector chunks removed from the index.",
            "title": "Deleted Chunks",
            "type": "integer"
          },
          "document_id": {
            "description": "The document that was removed.",
            "title": "Document Id",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "deleted_chunks"
        ],
        "title": "DeleteResponse",
        "type": "object"
      },
      "DocumentInfo": {
        "description": "One corpus document, merging on-disk facts with ingestion status.",
        "properties": {
          "department": {
            "description": "Top-level folder the document lives under.",
            "title": "Department",
            "type": "string"
          },
          "document_id": {
            "description": "Path relative to docs/ (stable id), e.g. hr/employment-basics.md.",
            "title": "Document Id",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Failure reason when status is failed.",
            "title": "Error"
          },
          "size_bytes": {
            "description": "File size on disk.",
            "title": "Size Bytes",
            "type": "integer"
          },
          "status": {
            "description": "queued | processing | indexed | failed | unknown.",
            "title": "Status",
            "type": "string"
          },
          "type": {
            "description": "File extension without the dot (md/pdf/csv/...).",
            "title": "Type",
            "type": "string"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the status last changed (ISO 8601).",
            "title": "Updated At"
          }
        },
        "required": [
          "document_id",
          "department",
          "type",
          "size_bytes",
          "status"
        ],
        "title": "DocumentInfo",
        "type": "object"
      },
      "DocumentStatusResponse": {
        "description": "Response for ``GET /admin/documents/{document_id}/status``.",
        "properties": {
          "document_id": {
            "description": "Path relative to docs/.",
            "title": "Document Id",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Failure reason when status is failed.",
            "title": "Error"
          },
          "status": {
            "description": "queued | processing | indexed | failed.",
            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the status last changed (ISO 8601).",
            "title": "Updated At"
          }
        },
        "required": [
          "document_id",
          "status"
        ],
        "title": "DocumentStatusResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HistoryResponse": {
        "description": "Response for ``GET /chat/history/{session_id}``.",
        "properties": {
          "history": {
            "description": "Ordered {role, content} messages.",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "History",
            "type": "array"
          },
          "session_id": {
            "description": "The session the history belongs to.",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "HistoryResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 72,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MeResponse": {
        "description": "Response for ``GET /auth/me``.",
        "properties": {
          "id": {
            "description": "User id.",
            "title": "Id",
            "type": "integer"
          },
          "region": {
            "description": "Caller's home region.",
            "title": "Region",
            "type": "string"
          },
          "role": {
            "description": "Caller's role.",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "region"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "MessageResponse": {
        "description": "Generic ``{\"message\": ...}`` acknowledgement.",
        "properties": {
          "message": {
            "description": "Human-readable result.",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "MessageResponse",
        "type": "object"
      },
      "PreferencesResponse": {
        "description": "Response for ``GET/PUT /me/preferences`` (always complete via defaults).",
        "properties": {
          "language": {
            "description": "Preferred answer language.",
            "title": "Language",
            "type": "string"
          },
          "response_length": {
            "description": "Preferred answer length.",
            "title": "Response Length",
            "type": "string"
          },
          "tone": {
            "description": "Preferred tone.",
            "title": "Tone",
            "type": "string"
          }
        },
        "required": [
          "tone",
          "response_length",
          "language"
        ],
        "title": "PreferencesResponse",
        "type": "object"
      },
      "ReindexResponse": {
        "description": "Response for ``POST /admin/reindex``.",
        "properties": {
          "deleted": {
            "description": "Stale chunks removed before re-adding.",
            "title": "Deleted",
            "type": "integer"
          },
          "indexed": {
            "description": "Chunks added in this run.",
            "title": "Indexed",
            "type": "integer"
          },
          "skipped": {
            "description": "Files unchanged and skipped.",
            "title": "Skipped",
            "type": "integer"
          }
        },
        "required": [
          "indexed",
          "skipped",
          "deleted"
        ],
        "title": "ReindexResponse",
        "type": "object"
      },
      "RenameSessionRequest": {
        "description": "Body for ``PATCH /chat/sessions/{session_id}``.",
        "properties": {
          "title": {
            "description": "New session title.",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "RenameSessionRequest",
        "type": "object"
      },
      "SessionInfo": {
        "description": "One conversation owned by the caller (list item for the sidebar).",
        "properties": {
          "session_id": {
            "description": "Conversation id.",
            "title": "Session Id",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "User-set title, if any.",
            "title": "Title"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Last activity (ISO 8601).",
            "title": "Updated At"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "SessionInfo",
        "type": "object"
      },
      "Source": {
        "description": "One cited chunk, in the frozen shape the React client binds to.",
        "properties": {
          "document_id": {
            "description": "Stable doc id = path relative to docs/ (e.g. hr/x.md).",
            "title": "Document Id",
            "type": "string"
          },
          "file": {
            "description": "Human-facing filename (basename of document_id).",
            "title": "File",
            "type": "string"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Parent section heading, when known.",
            "title": "Section"
          },
          "source_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Access tier the chunk came from (all/manager/hr_only).",
            "title": "Source Type"
          }
        },
        "required": [
          "document_id",
          "file"
        ],
        "title": "Source",
        "type": "object"
      },
      "TokenResponse": {
        "description": "Response for ``POST /auth/login`` and ``POST /auth/refresh``.",
        "properties": {
          "access_token": {
            "description": "Short-lived bearer access token.",
            "title": "Access Token",
            "type": "string"
          },
          "region": {
            "description": "Caller's home region (us/india).",
            "title": "Region",
            "type": "string"
          },
          "role": {
            "description": "Caller's role (employee/manager/hr).",
            "title": "Role",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "description": "Always 'bearer'.",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "role",
          "region"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "UpdatePreferencesRequest": {
        "description": "Body for ``PUT /me/preferences``. Any field may be omitted/null to clear it.",
        "properties": {
          "language": {
            "anyOf": [
              {
                "maxLength": 50,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Preferred answer language.",
            "title": "Language"
          },
          "response_length": {
            "anyOf": [
              {
                "maxLength": 50,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "short | medium | long.",
            "title": "Response Length"
          },
          "tone": {
            "anyOf": [
              {
                "maxLength": 50,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "e.g. friendly, formal, concise.",
            "title": "Tone"
          }
        },
        "title": "UpdatePreferencesRequest",
        "type": "object"
      },
      "UploadResponse": {
        "description": "Response for ``POST /admin/documents/upload``.",
        "properties": {
          "document_id": {
            "description": "Path relative to docs/ assigned to the upload.",
            "title": "Document Id",
            "type": "string"
          },
          "status": {
            "description": "Initial status \u2014 always 'queued'; indexing runs in the background.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "status"
        ],
        "title": "UploadResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "AI-powered chatbot backend using LiteLLM + RAG",
    "title": "Company Chatbot API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/documents": {
      "get": {
        "description": "List every corpus document, merging on-disk facts with ingestion status.",
        "operationId": "list_documents_admin_documents_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentInfo"
                  },
                  "title": "Response List Documents Admin Documents Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Documents",
        "tags": [
          "Admin"
        ]
      }
    },
    "/admin/documents/upload": {
      "post": {
        "description": "Accept a document, store it under ``docs/<department>/``, queue ingestion.",
        "operationId": "upload_document_admin_documents_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_document_admin_documents_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Upload Document",
        "tags": [
          "Admin"
        ]
      }
    },
    "/admin/documents/{document_id}": {
      "delete": {
        "description": "Remove a document: its vector chunks, the file on disk, and its status row.",
        "operationId": "delete_document_admin_documents__document_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete Document",
        "tags": [
          "Admin"
        ]
      }
    },
    "/admin/documents/{document_id}/status": {
      "get": {
        "description": "Return one document's ingestion status.",
        "operationId": "document_status_admin_documents__document_id__status_get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Document Status",
        "tags": [
          "Admin"
        ]
      }
    },
    "/admin/reindex": {
      "post": {
        "description": "Rebuild the index from the corpus (hash-skip aware; only changed files re-embed).",
        "operationId": "reindex_admin_reindex_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReindexResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Reindex",
        "tags": [
          "Admin"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Revoke the current refresh token and clear the cookie.",
        "operationId": "logout_auth_logout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "description": "Rotate: validate the refresh cookie, revoke its jti, issue a fresh pair.",
        "operationId": "refresh_auth_refresh_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Refresh",
        "tags": [
          "Auth"
        ]
      }
    },
    "/chat": {
      "post": {
        "description": "Send a message and receive an AI response with RAG context.\n\nThe user's role gates which document tiers are retrievable (RBAC).",
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Chat",
        "tags": [
          "Chat"
        ]
      }
    },
    "/chat/history/{session_id}": {
      "delete": {
        "description": "Clear conversation history for a session.",
        "operationId": "clear_history_chat_history__session_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            },
            "description": "Successful Response"
